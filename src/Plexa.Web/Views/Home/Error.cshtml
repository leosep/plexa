@model int
@{
    var (code, title, body) = Model switch
    {
        403 => ("403", L["Error.403.Title"].Value, L["Error.403.Body"].Value),
        404 => ("404", L["Error.404.Title"].Value, L["Error.404.Body"].Value),
        _ => ("500", L["Error.500.Title"].Value, L["Error.500.Body"].Value)
    };
}
@{
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : null;
    ViewData["Title"] = title;
}
<div class="mx-auto flex max-w-lg flex-col items-center py-16 text-center">
    <p class="text-6xl font-semibold tracking-tight text-brand-600">@code</p>
    <h1 class="mt-3 text-2xl font-semibold">@title</h1>
    <p class="mt-2 text-sm text-ink-600">@body</p>
    <div class="mt-6 flex gap-2">
        <a href="/dashboard" class="plx-btn-primary">@L["Common.BackToDashboard"]</a>
        <a href="mailto:support@plexa.app" class="plx-btn-secondary">@L["Nav.HelpSupport"]</a>
    </div>
</div>
