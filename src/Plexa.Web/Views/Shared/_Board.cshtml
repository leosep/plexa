@model BoardPageViewModel
@{
    var board = Model.Board;
    var filters = board.Filters;
}
<div id="board-results" class="grid gap-4 lg:grid-cols-4">
    @foreach (var column in board.Columns)
    {
        var accent = column.Status switch
        {
            WorkTaskStatus.ToDo => "bg-status-todo",
            WorkTaskStatus.InProgress => "bg-status-progress",
            WorkTaskStatus.Review => "bg-status-review",
            _ => "bg-status-done"
        };
        <section class="flex min-h-40 flex-col rounded-2xl bg-ink-100/80" aria-labelledby="column-@column.Status">
            <header class="flex items-center gap-2 px-3 py-3">
                <span class="size-2.5 rounded-full @accent" aria-hidden="true"></span>
                <h2 id="column-@column.Status" class="text-sm font-semibold">@L.Label(column.Title)</h2>
                <span class="ml-auto rounded-full bg-white px-2 py-0.5 text-xs font-medium tabular-nums text-ink-600">@column.Count</span>
            </header>

            <div class="flex-1 space-y-2.5 px-2.5 pb-2.5">
                @foreach (var card in column.Cards)
                {
                    <partial name="_TaskCard" model="card" />
                }

                <button type="button" class="w-full rounded-xl border border-dashed border-ink-200 px-3 py-2 text-xs font-medium text-ink-400 hover:border-brand-500 hover:text-brand-700"
                        hx-get="/tasks/new?project=@filters.ProjectId" hx-target="#modal-root" hx-swap="innerHTML">
                    + @L["Board.AddTask"]
                </button>
            </div>
        </section>
    }
</div>
