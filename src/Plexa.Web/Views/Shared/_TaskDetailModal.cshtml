@model TaskDetailDto
@{
    var canApprove = ViewData["CanApprove"] as bool? == true;
}
<dialog class="plx-modal max-w-2xl" aria-labelledby="task-detail-title" x-data="{}" @@close="window.plexaCloseModal()">
    <div class="flex items-start justify-between gap-3 border-b border-ink-200 px-6 py-4">
        <div class="min-w-0">
            @if (!string.IsNullOrWhiteSpace(Model.ProjectCode))
            {
                <p class="text-xs font-medium uppercase tracking-wide text-ink-400">@Model.ProjectCode · @Model.ProjectName</p>
            }
            <h2 id="task-detail-title" class="mt-1 truncate text-xl font-semibold">@Model.Title</h2>
            @if (!string.IsNullOrWhiteSpace(Model.ParentTitle))
            {
                <p class="mt-1 text-xs text-ink-400">↳ @Model.ParentTitle</p>
            }
        </div>
        <button type="button" class="plx-btn-ghost -mr-2 -mt-1" @@click="window.plexaCloseModal()" aria-label="@L["Common.Close"]">✕</button>
    </div>

    <div class="plx-modal-body" id="task-detail-body">
        <partial name="_TaskDetailBody" model="Model" />
    </div>

    <div class="flex flex-wrap items-center gap-2 border-t border-ink-200 px-6 py-3">
        <div x-data="plexaTimer({ taskId: '@Model.Id', running: @(Model.TimerRunning ? "true" : "false"), seconds: @((int)Model.Logged.TotalSeconds) })" x-init="init()">
            <button type="button" class="plx-btn-primary" @@click="toggle()" :aria-pressed="running.toString()" :disabled="busy">
                <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                    <path x-show="!running" d="M8 5v14l11-7z"/>
                    <path x-show="running" style="display:none" d="M7 5h4v14H7zM13 5h4v14h-4z"/>
                </svg>
                <span x-text="running ? '@L["Timer.Stop"]' : '@L["Timer.Start"]'">@(Model.TimerRunning ? L["Timer.Stop"].Value : L["Timer.Start"].Value)</span>
            </button>
        </div>

        <button type="button" class="plx-btn-secondary"
                hx-get="/tasks/@Model.Id/edit" hx-target="#modal-root" hx-swap="innerHTML">
            @L["Common.Edit"]
        </button>

        @if (canApprove && Model.AwaitingApproval)
        {
            <button type="button" class="plx-btn-secondary"
                    hx-post="/board/approve" hx-vals='{"id":"@Model.Id"}' hx-target="#modal-root" hx-swap="innerHTML">
                @L["Task.Approve"]
            </button>
        }

        @if (User.IsInRole("Admin"))
        {
            <button type="button" class="plx-btn-ghost ml-auto text-danger-500"
                    hx-post="/tasks/@Model.Id/delete" hx-confirm="@L["Task.DeleteConfirm"]" hx-swap="none">
                @L["Common.Delete"]
            </button>
        }
    </div>
</dialog>
