@model KpiCard
@{
    var tone = Model.Tone switch
    {
        "danger" => "text-danger-500",
        "success" => "text-brand-700",
        _ => "text-ink-900"
    };
    var ring = Model.Tone switch
    {
        "danger" => "ring-danger-100",
        "success" => "ring-brand-100",
        _ => "ring-ink-200"
    };
}
<article class="plx-card p-5 ring-1 @ring">
    <p class="text-xs font-medium uppercase tracking-wide text-ink-400">@Model.Label</p>
    <p class="mt-2 text-3xl font-semibold tabular-nums @tone">@Model.Value</p>
    @if (!string.IsNullOrWhiteSpace(Model.Context))
    {
        <p class="mt-1 text-sm text-ink-600">@Model.Context</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Trend))
    {
        <p class="mt-2 text-xs font-medium @tone">@Model.Trend</p>
    }
</article>
