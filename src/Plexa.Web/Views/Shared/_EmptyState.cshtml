@model Plexa.Web.Models.EmptyStateModel
<div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-ink-200 bg-white/60 px-6 py-12 text-center">
    <div class="grid size-12 place-items-center rounded-2xl bg-ink-100 text-ink-400">
        <partial name="_Icon" model="@(Model.Icon ?? "grid")" />
    </div>
    <h3 class="mt-4 text-base font-semibold">@Model.Title</h3>
    @if (!string.IsNullOrWhiteSpace(Model.Body))
    {
        <p class="mt-1 max-w-sm text-sm text-ink-600">@Model.Body</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.CtaLabel) && !string.IsNullOrWhiteSpace(Model.CtaHref))
    {
        <a href="@Model.CtaHref" class="plx-btn-primary mt-4">@Model.CtaLabel</a>
    }
</div>
