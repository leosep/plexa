@model IReadOnlyList<ActivityItemDto>
@if (Model.Count == 0)
{
    <p class="mt-4 text-sm text-ink-400">@L["Projects.NoActivity"]</p>
}
else
{
    <ol class="mt-4 space-y-3">
        @foreach (var item in Model)
        {
            <li class="flex gap-3">
                @await Component.InvokeAsync("Avatar", new { name = item.Actor.FullName, path = item.Actor.AvatarPath, size = 26 })
                <div class="min-w-0 flex-1">
                    <p class="text-sm leading-snug">
                        <span class="font-medium">@item.Actor.FullName</span>
                        <span class="text-ink-600">@item.Text</span>
                    </p>
                    <p class="mt-0.5 text-[11px] text-ink-400">@item.RelativeLabel</p>
                </div>
            </li>
        }
    </ol>
}
