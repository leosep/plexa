@{
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
    var items = new (string Href, string Key, string Icon)[]
    {
        ("/dashboard", "Nav.Dashboard", "grid"),
        ("/board", "Nav.Board", "kanban"),
        ("/projects", "Nav.Projects", "folder"),
        ("/team", "Nav.Team", "users"),
        ("/reports", "Nav.Reports", "chart"),
        ("/analytics", "Nav.Analytics", "activity"),
        ("/calendar", "Nav.Calendar", "calendar"),
        ("/messages", "Nav.Messages", "chat"),
        ("/settings", "Nav.Settings", "cog")
    };
}
<aside class="plx-no-print hidden border-r border-ink-200 bg-white lg:flex lg:flex-col">
    <div class="flex h-16 items-center gap-2 border-b border-ink-200 px-4">
        <img src="/img/logo.svg" alt="" class="size-8" />
        <div class="min-w-0">
            <p class="truncate text-sm font-semibold leading-4">Grupo Dominican Watchman</p>
            <p class="text-[11px] text-ink-400">@L["Nav.Workspace"]</p>
        </div>
    </div>

    <nav class="flex-1 space-y-6 overflow-y-auto px-3 py-4" aria-label="@L["Nav.MainMenu"]">
        <div>
            <p class="px-3 pb-1.5 text-[11px] font-semibold uppercase tracking-wider text-ink-400">@L["Nav.Menu"]</p>
            <div class="space-y-0.5">
                @foreach (var item in items)
                {
                    <a href="@item.Href" class="plx-nav-item @Active(item.Href)" aria-current="@(Active(item.Href) == "is-active" ? "page" : null)">
                        <partial name="_Icon" model="@item.Icon" />
                        <span>@L[item.Key]</span>
                    </a>
                }
            </div>
        </div>

        <div>
            <p class="px-3 pb-1.5 text-[11px] font-semibold uppercase tracking-wider text-ink-400">@L["Nav.ActiveSprint"]</p>
            <div class="rounded-xl bg-ink-100 p-3">
                <p class="text-sm font-medium text-ink-600">@L["Nav.NoActiveSprint"]</p>
                <p class="mt-1 text-xs text-ink-400">@L["Nav.SprintHint"]</p>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/sprints" class="mt-2 inline-flex text-xs font-medium text-brand-700 hover:underline">@L["Nav.ManageSprints"]</a>
                }
            </div>
        </div>

        <div>
            <p class="px-3 pb-1.5 text-[11px] font-semibold uppercase tracking-wider text-ink-400">@L["Nav.General"]</p>
            <div class="space-y-0.5">
                <a href="mailto:support@plexa.app" class="plx-nav-item">
                    <partial name="_Icon" model="@("help")" />
                    <span>@L["Nav.HelpSupport"]</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/members" class="plx-nav-item @Active("/admin")">
                        <partial name="_Icon" model="@("shield")" />
                        <span>@L["Nav.Admin"]</span>
                    </a>
                }
            </div>
        </div>
    </nav>

    <div class="p-3">
        <div class="rounded-2xl bg-gradient-to-br from-brand-600 to-cyan-500 p-4 text-white">
            <p class="text-sm font-semibold">@L["Nav.UpgradeTitle"]</p>
            <p class="mt-1 text-xs text-white/80">@L["Nav.UpgradeBody"]</p>
            <a href="/settings?section=preferences" class="mt-3 inline-flex rounded-xl bg-white/15 px-3 py-1.5 text-xs font-medium hover:bg-white/25">@L["Nav.UpgradeCta"]</a>
        </div>
    </div>
</aside>

<!-- Drawer móvil -->
<div x-show="mobileNav" x-cloak class="fixed inset-0 z-50 lg:hidden">
    <div class="absolute inset-0 bg-ink-900/45" @@click="mobileNav = false" x-transition.opacity></div>
    <div class="absolute inset-y-0 left-0 w-72 overflow-y-auto bg-white p-4 shadow-2xl" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="-translate-x-full" x-transition:enter-end="translate-x-0">
        <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <img src="/img/logo.svg" alt="" class="size-8" />
                <span class="text-sm font-semibold">@L["App.Name"]</span>
            </div>
            <button type="button" class="plx-btn-ghost" @@click="mobileNav = false" aria-label="@L["Common.Close"]">✕</button>
        </div>
        <nav class="space-y-1" aria-label="@L["Nav.MainMenu"]">
            @foreach (var item in items)
            {
                <a href="@item.Href" class="plx-nav-item @Active(item.Href)">
                    <partial name="_Icon" model="@item.Icon" />
                    <span>@L[item.Key]</span>
                </a>
            }
        </nav>
    </div>
</div>
