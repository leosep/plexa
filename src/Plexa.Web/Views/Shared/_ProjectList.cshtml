@model ProjectListDto
<div id="project-list" class="plx-card overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="p-6">
            <partial name="_EmptyState" model="@(new EmptyStateModel(L["Projects.EmptyTitle"].Value, L["Projects.EmptyBody"].Value, L["Projects.ClearFilters"].Value, "/projects", "folder"))" />
        </div>
    }
    else
    {
        <div class="overflow-x-auto [contain:paint]">
            <table class="plx-table min-w-[52rem]">
                <caption class="sr-only">@L["Projects.Title"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@L["Projects.Column.Project"]</th>
                        <th scope="col">@L["Projects.Column.Client"]</th>
                        <th scope="col">@L["Projects.Column.Lead"]</th>
                        <th scope="col">@L["Projects.Column.Status"]</th>
                        <th scope="col">@L["Projects.Column.Progress"]</th>
                        <th scope="col" class="text-right">@L["Projects.Column.Budget"]</th>
                        <th scope="col">@L["Projects.Column.Delivery"]</th>
                        <th scope="col" class="text-right"><span class="sr-only">@L["Projects.Column.Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model.Items)
                    {
                        <tr class="cursor-pointer" onclick="if(!event.target.closest('a')) window.location='/projects/@project.Id'">
                            <td>
                                <a href="/projects/@project.Id" class="flex items-center gap-3">
                                    <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-brand-50 text-xs font-semibold text-brand-700">@project.Initials</span>
                                    <span class="min-w-0">
                                        <span class="block truncate font-medium text-ink-900 hover:text-brand-700">@project.Name</span>
                                        <span class="block text-xs text-ink-400">@project.Code</span>
                                    </span>
                                </a>
                            </td>
                            <td class="text-ink-600">@project.Client</td>
                            <td>
                                @if (project.Lead is not null)
                                {
                                    <span class="flex items-center gap-2">
                                        @await Component.InvokeAsync("Avatar", new { name = project.Lead.FullName, path = project.Lead.AvatarPath, size = 24 })
                                        <span class="text-sm">@project.Lead.FullName</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-ink-400">—</span>
                                }
                            </td>
                            <td>
                                <span class="plx-chip @(project.Status == ProjectStatus.AtRisk ? "bg-danger-100 text-danger-500" : project.Status == ProjectStatus.Completed ? "bg-brand-50 text-brand-700" : "bg-ink-100 text-ink-600")">@L.Label(project.StatusLabel)</span>
                            </td>
                            <td class="w-40">
                                <div class="flex items-center gap-2">
                                    <div class="h-1.5 w-24 overflow-hidden rounded-full bg-ink-100">
                                        <div class="h-full rounded-full bg-brand-500" style="width:@project.ProgressPct%"></div>
                                    </div>
                                    <span class="text-xs tabular-nums text-ink-600">@project.ProgressPct%</span>
                                </div>
                                <p class="mt-0.5 text-[11px] text-ink-400">@project.TasksDone/@project.TasksTotal @L["Projects.Tasks"]</p>
                            </td>
                            <td class="text-right tabular-nums text-ink-600">@(project.Budget.HasValue ? $"US${project.Budget.Value:N0}" : "—")</td>
                            <td class="text-ink-600">@(project.EndDate?.ToString("dd MMM") ?? "—")</td>
                            <td class="text-right">
                                <a href="/projects/@project.Id" class="plx-btn-ghost px-2 py-1 text-xs">@L["Common.Open"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-ink-100 px-4 py-3 text-xs text-ink-400">
            <span>@Model.Items.Count @L["Projects.Of"] @Model.Total @L["Projects.CountLabel"]</span>
            <span>@L["Projects.RowHint"]</span>
        </div>
    }
</div>
