@{
    var threads = ViewData["Threads"] as IReadOnlyList<ThreadSummaryDto> ?? [];
}
<dialog class="plx-modal" aria-labelledby="thread-form-title">
    <form hx-post="/messages/new" hx-target="#modal-root" hx-swap="innerHTML" novalidate>
        @Html.AntiForgeryToken()

        <div class="flex items-start justify-between gap-3 border-b border-ink-200 px-6 py-4">
            <div>
                <h2 id="thread-form-title" class="text-xl font-semibold">@L["Messages.NewChannel"]</h2>
                <p class="mt-0.5 text-xs text-ink-400">@L["Messages.NewChannelHint"]</p>
            </div>
            <button type="button" class="plx-btn-ghost -mr-2 -mt-1" onclick="window.plexaCloseModal()" aria-label="@L["Common.Close"]">✕</button>
        </div>

        <div class="plx-modal-body space-y-4">
            <div>
                <label for="thread-title-input" class="plx-label">@L["Messages.Field.Title"]</label>
                <input id="thread-title-input" name="title" class="plx-input" required maxlength="120" autofocus placeholder="@L["Messages.Field.TitlePlaceholder"]" />
            </div>
            <div>
                <label for="thread-scope" class="plx-label">@L["Messages.Field.Scope"]</label>
                <select id="thread-scope" name="scope" class="plx-input">
                    @foreach (var scope in Enum.GetValues<ThreadScope>())
                    {
                        <option value="@scope">@scope</option>
                    }
                </select>
            </div>
            @{
                var projects = ViewData["Projects"] as IReadOnlyList<ProjectOption> ?? [];
            }
            <div>
                <label for="thread-project" class="plx-label">@L["Calendar.Field.Project"]</label>
                <select id="thread-project" name="projectId" class="plx-input">
                    <option value="">@L["Calendar.NoProject"]</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Label</option>
                    }
                </select>
            </div>
            <p class="rounded-xl bg-ink-100 px-3 py-2 text-xs text-ink-600">@threads.Count @L["Messages.ExistingThreads"]</p>
        </div>

        <div class="flex items-center justify-end gap-2 border-t border-ink-200 px-6 py-3">
            <button type="button" class="plx-btn-secondary" onclick="window.plexaCloseModal()">@L["Common.Cancel"]</button>
            <button type="submit" class="plx-btn-primary">@L["Messages.Create"]</button>
        </div>
    </form>
</dialog>
