@model AdminMembersViewModel
@{
    ViewData["Title"] = L["Admin.Members"].Value;
    ViewData["Section"] = L["Nav.Admin"].Value;
}
<div class="space-y-6">
    <header>
        <h1 class="text-3xl font-semibold tracking-tight">@L["Admin.Members"]</h1>
        <p class="mt-1 text-sm text-ink-600">@L["Admin.MembersSubtitle"]</p>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="rounded-xl bg-brand-50 px-3 py-2 text-sm text-brand-700" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="rounded-xl bg-danger-100 px-3 py-2 text-sm text-danger-500" role="alert">@error</div>
    }

    <div class="grid gap-4 xl:grid-cols-[1fr_22rem]">
        <section class="plx-card overflow-hidden" aria-labelledby="members-title">
            <h2 id="members-title" class="border-b border-ink-100 px-5 py-4 text-lg font-semibold">@L["Admin.TeamMembers"]</h2>
            <div class="overflow-x-auto">
                <table class="plx-table min-w-[40rem]">
                    <caption class="sr-only">@L["Admin.TeamMembers"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@L["Settings.Name"]</th>
                            <th scope="col">@L["Settings.Role"]</th>
                            <th scope="col" class="text-right">@L["Admin.CapacityHours"]</th>
                            <th scope="col" class="text-right"><span class="sr-only">@L["Projects.Column.Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td>
                                    <div class="flex items-center gap-2">
                                        <span class="grid size-8 place-items-center rounded-full bg-brand-100 text-xs font-semibold text-brand-700">@member.Initials</span>
                                        <div class="min-w-0">
                                            <p class="truncate font-medium">@member.FullName</p>
                                            <p class="truncate text-xs text-ink-400">@member.Email</p>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="plx-chip @(member.Role == WorkspaceRole.Admin ? "bg-accent-100 text-accent-500" : "bg-ink-100 text-ink-600")">
                                        @(member.Role == WorkspaceRole.Admin ? L["Role.Admin"].Value : L["Role.Member"].Value)
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(member.JobTitle))
                                    {
                                        <p class="mt-0.5 text-xs text-ink-400">@member.JobTitle</p>
                                    }
                                </td>
                                <td class="text-right tabular-nums">@member.CapacityHours.ToString("0.#")h</td>
                                <td class="text-right">
                                    <button type="button" class="plx-btn-ghost px-2 py-1 text-xs"
                                            onclick="document.getElementById('edit-member-@member.Id').showModal()">@L["Common.Edit"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @foreach (var member in Model.Members)
            {
                <dialog id="edit-member-@member.Id" class="plx-modal">
                    <form method="post" action="/admin/members/@member.Id">
                        @Html.AntiForgeryToken()
                        <div class="border-b border-ink-200 px-6 py-4">
                            <h3 class="text-lg font-semibold">@L["Admin.EditMember"]</h3>
                            <p class="mt-0.5 text-xs text-ink-400">@member.Email</p>
                        </div>
                        <div class="plx-modal-body space-y-3">
                            <div>
                                <label for="member-name-@member.Id" class="plx-label">@L["Settings.Name"]</label>
                                <input id="member-name-@member.Id" name="fullName" value="@member.FullName" class="plx-input" required />
                            </div>
                            <div>
                                <label for="member-job-@member.Id" class="plx-label">@L["Settings.Role"]</label>
                                <input id="member-job-@member.Id" name="jobTitle" value="@member.JobTitle" class="plx-input" />
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label for="member-role-@member.Id" class="plx-label">@L["Admin.Role"]</label>
                                    <select id="member-role-@member.Id" name="role" class="plx-input">
                                        @foreach (var role in Enum.GetValues<WorkspaceRole>())
                                        {
                                            <option value="@role" selected="@(member.Role == role)">@(role == WorkspaceRole.Admin ? L["Role.Admin"].Value : L["Role.Member"].Value)</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label for="member-capacity-@member.Id" class="plx-label">@L["Admin.CapacityHours"]</label>
                                    <input id="member-capacity-@member.Id" name="capacityHours" type="number" step="0.5" min="0" value="@member.CapacityHours.ToString("0.##")" class="plx-input tabular-nums" />
                                </div>
                            </div>
                        </div>
                        <div class="flex justify-end gap-2 border-t border-ink-200 px-6 py-3">
                            <button type="button" class="plx-btn-secondary" onclick="this.closest('dialog').close()">@L["Common.Cancel"]</button>
                            <button type="submit" class="plx-btn-primary">@L["Common.Save"]</button>
                        </div>
                    </form>
                </dialog>
            }
        </section>

        <section class="plx-card h-fit p-5" aria-labelledby="invite-title">
            <h2 id="invite-title" class="text-lg font-semibold">@L["Admin.InviteMember"]</h2>
            <form method="post" action="/admin/members" class="mt-4 space-y-3">
                @Html.AntiForgeryToken()
                <div>
                    <label for="invite-email" class="plx-label">@L["Login.Email"]</label>
                    <input id="invite-email" name="email" type="email" class="plx-input" required />
                </div>
                <div>
                    <label for="invite-name" class="plx-label">@L["Settings.Name"]</label>
                    <input id="invite-name" name="fullName" class="plx-input" required />
                </div>
                <div>
                    <label for="invite-job" class="plx-label">@L["Settings.Role"]</label>
                    <input id="invite-job" name="jobTitle" class="plx-input" placeholder="Full-Stack Developer" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="invite-role" class="plx-label">@L["Admin.Role"]</label>
                        <select id="invite-role" name="role" class="plx-input">
                            @foreach (var role in Enum.GetValues<WorkspaceRole>())
                            {
                                <option value="@role">@(role == WorkspaceRole.Admin ? L["Role.Admin"].Value : L["Role.Member"].Value)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="invite-capacity" class="plx-label">@L["Admin.CapacityHours"]</label>
                        <input id="invite-capacity" name="capacityHours" type="number" step="0.5" min="0" value="40" class="plx-input tabular-nums" />
                    </div>
                </div>
                <button type="submit" class="plx-btn-primary w-full">@L["Admin.SendInvite"]</button>
            </form>
        </section>
    </div>
</div>
