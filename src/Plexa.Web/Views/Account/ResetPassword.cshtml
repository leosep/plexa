@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Reset.Title"].Value;
}
<h1 class="text-2xl font-semibold tracking-tight">@L["Reset.Title"]</h1>
<p class="mt-2 text-sm text-ink-600">@L["Reset.Body"]</p>

<form method="post" action="/reset-password" class="mt-6 space-y-4" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Code" />
    <div asp-validation-summary="ModelOnly" class="rounded-xl bg-danger-100 px-3 py-2 text-sm text-danger-500 empty:hidden"></div>
    <div>
        <label asp-for="Password" class="plx-label">@L["Reset.Password"]</label>
        <input asp-for="Password" type="password" autocomplete="new-password" class="plx-input" autofocus />
        <span asp-validation-for="Password" class="mt-1 block text-xs text-danger-500"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="plx-label">@L["Reset.Confirm"]</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="plx-input" />
        <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-danger-500"></span>
    </div>
    <button type="submit" class="plx-btn-primary w-full py-2.5">@L["Reset.Submit"]</button>
    <a href="/login" class="block text-center text-sm font-medium text-brand-700 hover:underline">@L["Forgot.Back"]</a>
</form>
