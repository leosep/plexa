@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Forgot.Title"].Value;
}
<h1 class="text-2xl font-semibold tracking-tight">@L["Forgot.Title"]</h1>
<p class="mt-2 text-sm text-ink-600">@L["Forgot.Body"]</p>

<form method="post" action="/forgot-password" class="mt-6 space-y-4" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="rounded-xl bg-danger-100 px-3 py-2 text-sm text-danger-500 empty:hidden"></div>
    <div>
        <label asp-for="Email" class="plx-label">@L["Login.Email"]</label>
        <input asp-for="Email" type="email" autocomplete="email" placeholder="@L["Login.EmailPlaceholder"]" class="plx-input" autofocus />
        <span asp-validation-for="Email" class="mt-1 block text-xs text-danger-500"></span>
    </div>
    <button type="submit" class="plx-btn-primary w-full py-2.5">@L["Forgot.Submit"]</button>
    <a href="/login" class="block text-center text-sm font-medium text-brand-700 hover:underline">@L["Forgot.Back"]</a>
</form>
