@model string
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Forgot.SentTitle"].Value;
}
<div class="text-center">
    <div class="mx-auto grid size-12 place-items-center rounded-2xl bg-brand-50 text-2xl text-brand-700">✓</div>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">@L["Forgot.SentTitle"]</h1>
    <p class="mt-2 text-sm text-ink-600">@L["Forgot.SentBody"]</p>
    <p class="mt-1 text-sm font-medium text-ink-900">@Model</p>
    <a href="/login" class="plx-btn-secondary mt-6 w-full py-2.5">@L["Forgot.Back"]</a>
</div>
