@model MessagesPageViewModel
@{
    ViewData["Title"] = L["Messages.Title"].Value;
    ViewData["Section"] = L["Nav.Menu"].Value;
}
<div class="space-y-5">
    <header class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight">@L["Messages.Title"]</h1>
            <p class="mt-1 text-sm text-ink-600">@L["Messages.Subtitle"]</p>
        </div>
        @if (Model.CanCreate)
        {
            <button type="button" class="plx-btn-primary"
                    hx-get="/messages/new" hx-target="#modal-root" hx-swap="innerHTML">
                @L["Messages.NewChannel"]
            </button>
        }
    </header>

    @if (Model.Threads.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel(L["Messages.EmptyTitle"].Value, L["Messages.EmptyBody"].Value, Model.CanCreate ? L["Messages.NewChannel"].Value : null, Model.CanCreate ? null : null, "chat"))" />
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-[20rem_1fr]">
            <aside class="plx-card max-h-[70vh] overflow-y-auto" aria-label="@L["Messages.Threads"]">
                <ul class="divide-y divide-ink-100">
                    @foreach (var thread in Model.Threads)
                    {
                        var active = Model.Thread?.Id == thread.Id;
                        <li>
                            <a href="/messages/@thread.Id"
                               hx-get="/messages/@thread.Id" hx-target="#thread-panel" hx-swap="outerHTML" hx-push-url="true"
                               class="block px-4 py-3 hover:bg-ink-100/60 @(active ? "bg-brand-50/60" : "")"
                               aria-current="@(active ? "page" : null)">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="truncate text-sm font-medium">@thread.Title</p>
                                    @if (thread.Unread)
                                    {
                                        <span class="size-2 shrink-0 rounded-full bg-brand-500" aria-label="@L["Messages.Unread"]"></span>
                                    }
                                </div>
                                <p class="mt-0.5 truncate text-xs text-ink-400">
                                    <span class="plx-chip bg-ink-100 px-1.5 py-0 text-[10px] text-ink-600">@thread.ScopeLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(thread.ProjectLabel))
                                    {
                                        <span>· @thread.ProjectLabel</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(thread.LastMessagePreview))
                                {
                                    <p class="mt-1 truncate text-xs text-ink-600">@thread.LastAuthor: @thread.LastMessagePreview</p>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </aside>

            <partial name="_ThreadPanel" model="Model" />
        </div>
    }
</div>
