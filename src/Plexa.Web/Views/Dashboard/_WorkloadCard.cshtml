@model DashboardDto
<div class="mt-4 grid gap-3 md:grid-cols-3">
    @foreach (var member in Model.Workload)
    {
        <div class="rounded-xl bg-ink-100/70 p-3">
            <div class="flex items-center gap-2">
                @await Component.InvokeAsync("Avatar", new { name = member.Person.FullName, path = member.Person.AvatarPath, size = 28 })
                <div class="min-w-0">
                    <p class="truncate text-sm font-medium">@member.Person.FullName</p>
                    <p class="text-xs text-ink-400">@member.ActiveTasks @L["Team.Active"] · @member.OverdueTasks @L["Team.Overdue"]</p>
                </div>
            </div>
            <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white">
                <div class="h-full rounded-full bg-brand-500" style="width:@Math.Min(100, member.CapacityPercent)%"></div>
            </div>
            <div class="mt-2 flex items-center justify-between text-xs">
                <span class="font-medium tabular-nums text-ink-600">@member.CapacityPercent%</span>
                <span class="plx-chip bg-white text-ink-600">@member.SignalLabel</span>
            </div>
        </div>
    }
</div>
