# Copia este archivo a .env y completa los valores. .env está en .gitignore.
# Nunca subas credenciales reales al repositorio.
ConnectionStrings__Default="Server=SERVIDOR;Database=Plexa;User Id=USUARIO;Password=CLAVE;TrustServerCertificate=True"
Tests__ConnectionString="Server=SERVIDOR;Database=Plexa_Test;User Id=USUARIO;Password=CLAVE;TrustServerCertificate=True"

# Opcional: URL de una instancia en marcha para las pruebas E2E (Playwright).
# Sin esta variable las pruebas E2E se omiten.
E2E__BaseUrl="http://localhost:5199"
